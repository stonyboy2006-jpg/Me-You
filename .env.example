# ===================================
# Forever & Always Wedding Platform
# Environment Configuration
# ===================================
# Copy this file to .env and fill in your values

# Firebase Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps API Key (optional - for embedded maps)
WEDDING_MAPS_KEY=your_google_maps_api_key

# Application Settings
APP_NAME=Forever & Always
APP_URL=https://foreverandalwayswedding.com
APP_ENV=production
APP_DEBUG=false

# Security
SESSION_SECRET=generate_a_random_string_here
CORS_ORIGIN=https://foreverandalwayswedding.com

# Email (optional - for RSVP confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@foreverandalwayswedding.com

# Analytics (optional)
GA_TRACKING_ID=G-XXXXXXXXXX
